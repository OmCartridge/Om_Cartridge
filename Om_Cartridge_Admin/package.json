{
  "name": "om-cartridge-admin",
  "version": "1.0.0",
  "description": "OM Cartridge Stock & Billing Management System",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "node build.js",
    "seed": "cd server && npm run seed",
    "install:all": "cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "html-pdf-node": "^1.0.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
