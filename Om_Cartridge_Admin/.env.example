# ─── Server ───────────────────────────────────────────────────
PORT=5000

# MongoDB Atlas connection string (use mongodb+srv:// for production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<AppName>

# JWT
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_chars

# Admin seed credentials
ADMIN_EMAIL=admin@omcartridge.local
ADMIN_PASSWORD=Admin@123

# CORS — set to your Vercel deployment URL in production
# e.g. CORS_ORIGIN=https://om-cartridge.vercel.app
CORS_ORIGIN=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Business info
BUSINESS_NAME=OM ENTERPRISE
BUSINESS_GSTIN=24ACWPZ3281G1ZX

NODE_ENV=development

# ─── Client (prefix with VITE_) ───────────────────────────────
# Leave blank in production — frontend uses /api automatically
# VITE_API_URL=http://localhost:5000/api
