# OM Cartridge — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=OmCartridge

# ── JWT — generate a strong random secret ────────────────────────────────────
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── Admin Seed Credentials ────────────────────────────────────────────────────
# Used only when running: npm run seed
# Choose a strong password — this is the admin account.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── CORS — production frontend URL ───────────────────────────────────────────
FRONTEND_URL=https://om-cartridge.vercel.app

# ── SMTP (Gmail App Password recommended) ────────────────────────────────────
# Use an App Password, NOT your normal Gmail password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-business-email@gmail.com
SMTP_PASSWORD=GOOGLE_APP_PASSWORD_HERE
SMTP_FROM=your-business-email@gmail.com

# ── Business Info (optional overrides — Settings page is preferred) ───────────
BUSINESS_NAME=OM ENTERPRISE
BUSINESS_GSTIN=24ACWPZ3281G1ZX
