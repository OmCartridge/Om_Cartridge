{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "node_modules/pdfkit/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|invoices/).*)",
      "destination": "/index.html"
    }
  ]
}
